{
    "name": "cryptor",
    "displayName": "Cryptor",
    "description": "GnuPG and SOPS encryption and decryption, plus GnuPG signing, in VS Code",
    "version": "1.0.0",
    "publisher": "redsigma",
    "author": {
        "name": "RedSigma"
    },
    "homepage": "https://github.com/redsigma/vscode-cryptor",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/redsigma/vscode-cryptor"
    },
    "icon": "images/icon.png",
    "bugs": {
        "url": "https://github.com/redsigma/vscode-cryptor/issues"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "keywords": [
        "gpg",
        "gnupg",
        "pgp",
        "sops",
        "encrypt",
        "decrypt"
    ],
    "categories": [
        "Other"
    ],
    "activationEvents": ["onLanguage:jsonc", "onStartupFinished"],
    "main": "./src/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.cryptor.gpg.encryptSelection",
                "title": "Encrypt Selection",
                "category": "GPG",
                "when": "editorHasSelection"
            },
            {
                "command": "extension.cryptor.gpg.decryptSelection",
                "title": "Decrypt Selection",
                "category": "GPG",
                "when": "editorHasSelection"
            },
            {
                "command": "extension.cryptor.gpg.encryptArmoredFile",
                "title": "GPG: Encrypt armored file",
                "category": "GPG"
            },
            {
                "command": "extension.cryptor.gpg.encryptBinaryFile",
                "title": "GPG: Encrypt binary file",
                "category": "GPG"
            },
            {
                "command": "extension.cryptor.gpg.decryptFile",
                "title": "GPG: Decrypt file",
                "category": "GPG"
            },
            {
                "command": "extension.cryptor.gpg.clearSignSelection",
                "title": "Sign Selection (clear-sign)",
                "category": "GPG",
                "when": "editorHasSelection"
            },
            {
                "command": "extension.cryptor.gpg.validateSelectionClearSign",
                "title": "Verify Selected Signature",
                "category": "GPG",
                "when": "editorHasSelection"
            },
            {
                "command": "extension.cryptor.sops.encryptFile",
                "title": "SOPS: Encrypt file",
                "category": "Cryptor"
            },
            {
                "command": "extension.cryptor.sops.decryptFile",
                "title": "SOPS: Decrypt file",
                "category": "Cryptor"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "when": "false",
                    "command": "extension.cryptor.gpg.encryptArmoredFile"
                },
                {
                    "when": "false",
                    "command": "extension.cryptor.gpg.encryptBinaryFile"
                },
                {
                    "when": "false",
                    "command": "extension.cryptor.gpg.decryptFile"
                },
                {
                    "when": "false",
                    "command": "extension.cryptor.sops.encryptFile"
                },
                {
                    "when": "false",
                    "command": "extension.cryptor.sops.decryptFile"
                }
            ],
            "editor/context": [
                {
                    "when": "editorTextFocus && editorHasSelection && !cryptor.hideGpgEditorContextMenus",
                    "command": "extension.cryptor.gpg.encryptSelection",
                    "group": "cryptor@7"
                },
                {
                    "when": "editorTextFocus && editorHasSelection && !cryptor.hideGpgEditorContextMenus",
                    "command": "extension.cryptor.gpg.decryptSelection",
                    "group": "cryptor@7"
                }
            ],
            "explorer/context": [
                {
                    "when": "sideBarFocus && activeViewlet == 'workbench.view.explorer'",
                    "command": "extension.cryptor.gpg.encryptArmoredFile",
                    "group": "cryptor@7"
                },
                {
                    "when": "sideBarFocus && activeViewlet == 'workbench.view.explorer' && !explorerResourceIsFolder",
                    "command": "extension.cryptor.gpg.encryptBinaryFile",
                    "group": "cryptor@7"
                },
                {
                    "when": "sideBarFocus && activeViewlet == 'workbench.view.explorer' && resourceExtname =~ /(\\.asc|\\.gpg)$/",
                    "command": "extension.cryptor.gpg.decryptFile",
                    "group": "cryptor@7"
                },
                {
                    "when": "!explorerResourceIsFolder && resourceScheme =~ /^(file|vscode-remote)$/",
                    "command": "extension.cryptor.sops.decryptFile",
                    "group": "cryptor-sops@1"
                },
                {
                    "when": "!explorerResourceIsFolder && resourceScheme =~ /^(file|vscode-remote)$/",
                    "command": "extension.cryptor.sops.encryptFile",
                    "group": "cryptor-sops@2"
                }
            ]
        },
        "configuration": {
            "title": "Cryptor",
            "properties": {
                "cryptor": {
                    "type": "object",
                    "scope": "machine",
                    "description": "GPG and SOPS settings for Cryptor on the extension host.",
                    "default": {
                        "gpg.showEditorContextMenus": true,
                        "gpg.passphrases": [],
                        "gpg.encryptedFileSuffix": "asc",
                        "gpg.encryptedBinaryFileSuffix": "gpg",
                        "gpg.env": {},
                        "gpg.encryptcmd": "--trust-model always --recipient ${recipientID} --armor --trust-model always",
                        "gpg.encryptselectioncmd": "--batch --no-symkey-cache ${encryptcmd} --encrypt",
                        "gpg.encryptfilecmd": "--batch --no-symkey-cache --encrypt ${encryptcmd}",
                        "gpg.encryptbinaryfilecmd": "--batch --no-symkey-cache --encrypt ${encryptcmd} --no-armor",
                        "gpg.symmetricencryptcmd": "--batch --no-symkey-cache --passphrase-fd 0 --pinentry-mode loopback --armor --output - --symmetric -- ${source}",
                        "gpg.symmetricencryptbinaryfilecmd": "--batch --no-symkey-cache --passphrase-fd 0 --pinentry-mode loopback --no-armor --output - --symmetric -- ${source}",
                        "gpg.decryptcmd": "--decrypt",
                        "gpg.decryptselectioncmd": "--batch --no-symkey-cache ${decryptcmd}",
                        "gpg.decryptfilecmd": "--batch --no-symkey-cache --passphrase-fd 0 --pinentry-mode loopback --no-tty --quiet --output ${destination} ${decryptcmd} ${source}",
                        "gpg.signcmd": "--default-key ${recipientID} --trust-model always",
                        "gpg.signselectioncmd": "--batch ${signcmd} --clearsign",
                        "gpg.verifycmd": "--batch --trust-model always --status-fd 1 --verify",
                        "gpg.listkeyscmd": "--batch --list-keys --fixed-list-mode --fingerprint --with-colons",
                        "sops.path": "",
                        "sops.env": {},
                        "sops.ageKeyLookups": []
                    },
                    "additionalProperties": false,
                    "properties": {
                        "gpg.showEditorContextMenus": {
                            "type": "boolean",
                            "description": "Show editor context menus."
                        },
                        "gpg.passphrases": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "passphrase"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "description": "Email linked to the GPG key."
                                    },
                                    "description": {
                                        "type": "string",
                                        "description": "Optional description for the GPG key."
                                    },
                                    "passphrase": {
                                        "type": "string",
                                        "description": "Passphrase for the GPG Key."
                                    }
                                }
                            }
                        },
                        "gpg.encryptedFileSuffix": {
                            "type": "string",
                            "description": "Suffix for encrypted armored files."
                        },
                        "gpg.encryptedBinaryFileSuffix": {
                            "type": "string",
                            "description": "Suffix for encrypted binary files."
                        },
                        "gpg.env": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            },
                            "description": "Environment variables passed to GnuPG on the extension host."
                        },
                        "gpg.encryptcmd": {
                            "type": "string",
                            "description": "Shared GPG options for selection and file encryption."
                        },
                        "gpg.encryptselectioncmd": {
                            "type": "string",
                            "description": "GPG arguments for encrypting selected text."
                        },
                        "gpg.encryptfilecmd": {
                            "type": "string",
                            "description": "GPG arguments for armored file encryption with a recipient."
                        },
                        "gpg.encryptbinaryfilecmd": {
                            "type": "string",
                            "description": "GPG arguments for binary file encryption with a recipient."
                        },
                        "gpg.symmetricencryptcmd": {
                            "type": "string",
                            "description": "GPG arguments for encrypting armored files or selections with a passphrase."
                        },
                        "gpg.symmetricencryptbinaryfilecmd": {
                            "type": "string",
                            "description": "GPG arguments for binary file encryption with a passphrase."
                        },
                        "gpg.decryptcmd": {
                            "type": "string",
                            "description": "Shared GPG arguments for selection and file decryption."
                        },
                        "gpg.decryptselectioncmd": {
                            "type": "string",
                            "description": "GPG arguments for decrypting selected text."
                        },
                        "gpg.decryptfilecmd": {
                            "type": "string",
                            "description": "GPG arguments for file decryption."
                        },
                        "gpg.signcmd": {
                            "type": "string",
                            "description": "GPG options for clear-signing selections."
                        },
                        "gpg.signselectioncmd": {
                            "type": "string",
                            "description": "GPG arguments for clear-signing selected text."
                        },
                        "gpg.verifycmd": {
                            "type": "string",
                            "description": "GPG arguments for verifying selected signatures. Keep the status output on stdout."
                        },
                        "gpg.listkeyscmd": {
                            "type": "string",
                            "description": "GPG arguments for listing keys in the key picker. Keep the colon-separated output format."
                        },
                        "sops.path": {
                            "type": "string",
                            "description": "Absolute path to the SOPS executable on the extension host. Leave empty to use SOPS from PATH."
                        },
                        "sops.env": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            },
                            "description": "Environment variables passed to SOPS on the extension host."
                        },
                        "sops.ageKeyLookups": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "group",
                                    "directories",
                                    "filenames"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "group": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Unique name shown in the age identity group picker."
                                    },
                                    "directories": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "minItems": 1,
                                        "description": "Directory paths or strings starting with regex: to match immediate child directory names. The listed paths serve as parents for regex entries. With only regex entries, use the selected file's directory."
                                    },
                                    "filenames": {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "minItems": 1,
                                        "description": "Case-sensitive substrings or strings starting with regex: to match identity filenames."
                                    },
                                    "overrides": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                            "gpgExtensions": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string",
                                                    "minLength": 1
                                                },
                                                "description": "Case-insensitive filename suffixes or strings starting with regex: that select files requiring GPG."
                                            }
                                        }
                                    }
                                }
                            },
                            "description": "Groups of directories and filenames to search when SOPS needs an age identity."
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "version": "auto-changelog -t keepachangelog -p && git add CHANGELOG.md"
    },
    "devDependencies": {
        "@types/mocha": "^5.2.7",
        "@types/node": "^13.13.52",
        "@types/vscode": "1.74.0",
        "@vscode/test-electron": "^2.3.6",
        "auto-changelog": "^2.4.0",
        "eslint": "^6.8.0",
        "typescript": "^3.9.10"
    },
    "dependencies": {
        "fs": "0.0.1-security"
    }
}
